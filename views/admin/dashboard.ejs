<section class="section dashboard">
    <div class="row">
        
        <div class="col-xxl-3 col-md-3">
            <div class="card info-card sales-card">

            <div class="card-body">
                <h5 class="card-title">User Total</h5>

                <div class="d-flex align-items-center">
                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bx bx-group"></i>
                </div>
                <div class="ps-3">
                    <h2 class="text-black"><%= totalUsers %></h2>
                </div>
                </div>
            </div>

            </div>
        </div>

        <div class="col-xxl-3 col-md-3">
            <div class="card info-card revenue-card">
            <div class="card-body">
                <h5 class="card-title">Connected Users</span></h5>

                <div class="d-flex align-items-center">
                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bx bx-envelope"></i>
                </div>
                <div class="ps-3">
                    <h6><%= connectedUsers %></h6>
                </div>
                </div>
            </div>

            </div>
        </div>

        <div class="col-xxl-3 col-md-3">

            <div class="card info-card customers-card">

            <div class="card-body">
                <h5 class="card-title">Success Rate</h5>

                <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bx bxs-user-check"></i>
                    </div>
                    <div class="ps-3">
                        <h6><%= successRate %>%</h6>
                    </div>
                </div>
            </div>
            </div>

        </div>

        <div class="col-xxl-3 col-md-3">

            <div class="card info-card customers-card">
                <div class="card-body">
                    <h5 class="card-title">API Requests</span></h5>

                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bx bx-chat"></i>
                        </div>
                        <div class="ps-3">
                            <h6><%= apiRequestsToday %></h6>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Aktivitas Pesan (7 Hari Terakhir)</h5>
                    <div id="messageChart" style="min-height: 350px;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                <h5 class="card-title">Distribusi Status Pesan</h5>

                <% if (pieLabels.length > 0 && pieData.some(val => val > 0)) { %>
                    <div id="statusPieChart" style="min-height: 400px;" class="echart"></div>
                <% } else { %>
                    <div class="text-center text-muted py-5">
                    <i class="bi bi-pie-chart" style="font-size: 6rem;"></i><br>
                    Tidak ada data status pesan untuk ditampilkan.
                    </div>
                <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- SweetAlert Script -->
    <script src="/assets/js/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chartLabels = <%- JSON.stringify(chartLabels) %>;
            const chartData = <%- JSON.stringify(chartData) %>;

            const options = {
            chart: {
                type: 'area',
                height: 350,
                zoom: { enabled: false }
            },
            series: [{
                name: "Jumlah Pesan",
                data: chartData
            }],
            xaxis: {
                categories: chartLabels,
                title: { text: 'Tanggal' }
            },
            yaxis: {
                title: { text: 'Jumlah Pesan' },
                labels: {
                formatter: val => parseInt(val)
                }
            },
            stroke: {
                curve: 'smooth',
                width: 2
            },
            colors: ['#007bff'],
            fill: {
                type: "gradient",
                gradient: {
                shade: 'light',
                type: "vertical",
                shadeIntensity: 0.4,
                gradientToColors: ["#007bff"],
                inverseColors: false,
                opacityFrom: 0.7,
                opacityTo: 0.0,
                stops: [0, 90, 100]
                }
            },
            tooltip: {
                x: { format: 'dd MMM yyyy' }
            }
            };

            const chartEl = document.querySelector("#messageChart");
            if (chartEl) {
            const chart = new ApexCharts(chartEl, options);
            chart.render();
            }
        });
        
        const pieLabels = <%- JSON.stringify(pieLabels) %>;
        const pieData = <%- JSON.stringify(pieData) %>;

        const statusColorMap = {
            success: '#28a745',
            failed: '#dc3545',
            pending: '#ffc107',
            unknown: '#6c757d',
            custom: '#007bff'
        };

        const backgroundColors = pieLabels.map(label => statusColorMap[label] || '#999');

        document.addEventListener("DOMContentLoaded", () => {
            const pieData = <%- JSON.stringify(pieData) %>;
            const pieLabels = <%- JSON.stringify(pieLabels) %>;

            if (pieLabels.length > 0 && pieData.some(val => val > 0)) {
            const statusData = pieLabels.map((label, index) => ({
                value: pieData[index],
                name: label
            }));

            const chartDom = document.getElementById('statusPieChart');
            if (chartDom) {
                const myChart = echarts.init(chartDom);
                myChart.setOption({
                tooltip: {
                    trigger: 'item'
                },
                legend: {
                    orient: 'vertical',
                    left: 'left'
                },
                series: [{
                    name: 'Status',
                    type: 'pie',
                    radius: '50%',
                    data: statusData,
                    emphasis: {
                    itemStyle: {
                        shadowBlur: 10,
                        shadowOffsetX: 0,
                        shadowColor: 'rgba(0, 0, 0, 0.5)'
                    }
                    }
                }]
                });
            }
            }
        });

        function confirmReset(userId) {
            Swal.fire({
                title: 'Reset Session?',
                text: 'Session user akan dihapus dan harus login ulang.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Ya, reset!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/sessions/${userId}/reset`;
                document.body.appendChild(form);
                form.submit();
                }
            });
        }

        function confirmForceLogout(userId) {
            Swal.fire({
                title: 'Force Logout?',
                text: 'User akan dipaksa logout dari sesi WhatsApp.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f0ad4e',
                confirmButtonText: 'Ya, logout!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/sessions/${userId}/force-logout`;
                document.body.appendChild(form);
                form.submit();
                }
            });
        }
    </script>

</section>