<section class="section profile">
  <div class="row">
    <form class="row" method="POST" action="/admin/settings/save" enctype="multipart/form-data">
      <div class="col-xl-4">
        <div class="card">
          <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">
            <img id="logoPreview" src="<%= appLogo %>" alt="Logo" class="rounded mb-3" style="max-width: 120px; max-height: 120px;">
            <h2><%= settings.appName%></h2>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <h4 class="card-title">System Configuration</h4>

            <div class="mb-4">
              <label for="logo" class="form-label">App Logo</label>
              <input type="file" class="form-control d-none" id="logo" name="logo" accept="image/*">
              <button type="button" class="form-control btn btn-primary" onclick="document.getElementById('logo').click()">
                <i class="bx bx-upload"></i> Upload Logo
              </button>
              <span id="logoFilename" class="ms-2 text-muted"></span>
            </div>

            <div class="mb-4">
              <label for="appName" class="form-label">App Name</label>
              <input type="text" class="form-control" id="appName" name="appName" value="<%= settings.appName || '' %>" required>
            </div>

            <div class="mb-5">
              <label class="form-label">Registration Form</label>
              <div class="form-check form-switch">
                <input class="form-check-input" name="allow_registration" type="checkbox" id="toggleRegistration" <%= settings.allow_registration === 'true' ? 'checked' : '' %>>
                <label class="form-check-label" for="toggleRegistration">Allow New User Registration</label>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-xl-8">
        <div class="card">
          <div class="card-body">
            <h5 class="mt-4">Email (SMTP Settings)</h5>
            <small class="mb-4"><i>These settings are used for sending password reset links via email.</i></small>

            <div class="mb-3">
              <label for="smtp_host" class="form-label">SMTP Host</label>
              <input type="text" class="form-control" id="smtp_host" name="smtp_host" value="<%= settings.smtp_host || '' %>">
              <small><i>Default gmail: smtp.gmail.com</i></small>
            </div>

            <div class="mb-3">
              <label for="smtp_port" class="form-label">SMTP Port</label>
              <input type="number" class="form-control" id="smtp_port" name="smtp_port" value="<%= settings.smtp_port || '' %>">
              <small><i>Default gmail: 587</i></small>
            </div>

            <div class="mb-3">
              <label for="smtp_user" class="form-label">SMTP Username</label>
              <input type="text" class="form-control" id="smtp_user" name="smtp_user" value="<%= settings.smtp_user || '' %>">
              <small><i>Default gmail: example@mail.com</i></small>
            </div>

            <div class="mb-3">
              <label for="smtp_pass" class="form-label">SMTP Password</label>
              <input type="password" class="form-control" id="smtp_pass" name="smtp_pass" placeholder="******">
              <small><i>Default gmail: app password from google setting account</i></small>
            </div>

            <div class="mb-3">
              <label for="from_email" class="form-label">From Email Address</label>
              <input type="email" class="form-control" id="from_email" name="from_email" value="<%= settings.from_email || '' %>">
              <small><i>Example: example@mail.com</i></small>
            </div>

            <div class="mb-3">
              <label for="smtp_name" class="form-label">From Name</label>
              <input type="text" class="form-control" id="smtp_name" name="smtp_name" value="<%= settings.smtp_name || '' %>">
              <small><i>Example: Waserva Support</i></small>
            </div>


            <div class="mb-3">
              <label for="smtp_secure" class="form-label">Security</label>
              <select class="form-select" id="smtp_secure" name="smtp_secure">
                <option value="true" <%= (settings.smtp_secure === 'true' || !settings.smtp_secure) ? 'selected' : '' %>>SSL/TLS</option>
                <option value="false" <%= settings.smtp_secure === 'false' ? 'selected' : '' %>>None</option>
              </select>
            </div>

            <div class="text-center">
              <button type="submit" class="btn btn-primary"><i class="bx bx-save"></i> Save Change</button>
              <button type="button" id="resetBtn" class="btn btn-secondary">
                <i class="bx bx-undo"></i> Reset to Default
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
    <form id="resetForm" method="POST" action="/admin/settings/reset" style="display:none;"></form>

    <!-- Update Checker -->
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Update Checker</h5>
        <button id="checkUpdateBtn" class="btn btn-info d-flex align-items-center">
          <span class="spinner-border me-2 d-none" id="checkSpinner" role="status" aria-hidden="true"></span>
          Check Update
        </button>
      </div>
      <div class="card-body d-none" id="cardBodyContainer">
        <div id="updateResult"></div>
      </div>
    </div>
  </div>
  
  <!-- Toast Success -->
  <% if (Array.isArray(success) && success.length > 0) { %>
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div class="toast align-items-center text-bg-success border-0" role="alert" data-bs-delay="5000">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Success</strong>
                <small>Just now</small>
                <button type="button" class="btn-close btn-close-white ms-2 mb-1" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                <%= success[0] %>
            </div>
        </div>
    </div>
  <% } %>
  
  <!-- Toast Error -->
  <% if (Array.isArray(error) && error.length > 0) { %>
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div class="toast align-items-center text-bg-danger border-0" role="alert" data-bs-delay="5000">
            <div class="toast-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong class="me-auto">Error</strong>
                <small>Just now</small>
                <button type="button" class="btn-close btn-close-white ms-2 mb-1" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                <%= error[0] %>
            </div>
        </div>
    </div>
  <% } %>
  
  <!-- SweetAlert for Reset -->
  <script>
    const logoInput = document.getElementById('logo');
    const logoPreview = document.getElementById('logoPreview');
    const logoFilename = document.getElementById('logoFilename');
  
    logoInput.addEventListener('change', function () {
      const file = this.files[0];
      if (file) {
        logoFilename.textContent = file.name;
  
        const reader = new FileReader();
        reader.onload = function (e) {
          logoPreview.src = e.target.result;
        };
        reader.readAsDataURL(file);
      } else {
        logoFilename.textContent = '';
      }
    });
  
    document.getElementById('toggleRegistration')?.addEventListener('change', function () {
      const status = this.checked ? 'true' : 'false';
      fetch('/admin/settings/update-registration', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ value: status })
      }).then(res => {
        if (!res.ok) alert('Failed to update registration setting');
      });
    });
  
    document.getElementById('checkUpdateBtn').addEventListener('click', function () {
      const spinner = document.getElementById('checkSpinner');
      const resultContainer = document.getElementById('updateResult');
      const cardBody = document.getElementById('cardBodyContainer');

      spinner.classList.remove('d-none');
      resultContainer.innerHTML = '';
      cardBody.classList.remove('d-none');

      fetch('/admin/check-update', {
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin' // WAJIB agar session ikut
      })
        .then(res => {
          if (!res.ok) throw new Error(`HTTP error ${res.status}`);
          return res.json();
        })
        .then(data => {
          spinner.classList.add('d-none');

          if (data.updateAvailable) {
            resultContainer.innerHTML = `
              <div class="alert alert-warning">
                <strong>Update tersedia!</strong><br>
                Versi saat ini: <code>${data.currentVersion}</code><br>
                Versi terbaru: <code>${data.latestVersion}</code><br>
                ${data.changelog ? `<pre>${data.changelog}</pre>` : ''}
                <form method="POST" action="/admin/update" id="updateForm" class="mt-3">
                  <button type="submit" class="btn btn-success">
                    <i class="bi bi-download"></i> Install Update
                  </button>
                </form>
              </div>
            `;

            // Tambahkan event listener setelah HTML dimasukkan
            const updateForm = document.getElementById('updateForm');
            if (updateForm) {
              updateForm.addEventListener('submit', function (e) {
                e.preventDefault(); // Cegah submit langsung

                Swal.fire({
                  title: 'Yakin ingin menginstall update?',
                  text: 'Proses ini akan menggantikan file sistem yang lama.',
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonText: 'Ya, install sekarang!',
                  cancelButtonText: 'Batal'
                }).then((result) => {
                  if (result.isConfirmed) {
                    // Tampilkan proses update
                    Swal.fire({
                      title: 'Menginstall Update...',
                      html: 'Proses ini bisa memakan waktu beberapa detik.<br><br><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>',
                      allowOutsideClick: false,
                      showConfirmButton: false,
                      backdrop: true,
                      didOpen: () => {
                        // Submit form secara manual setelah spinner muncul
                        updateForm.submit();
                      }
                    });
                  }
                });
              });
            }

          } else {
            resultContainer.innerHTML = `
              <div class="alert alert-success">
                Aplikasi sudah menggunakan versi terbaru: <code>${data.currentVersion}</code>
              </div>
            `;
          }
        })
        .catch(err => {
          spinner.classList.add('d-none');
          resultContainer.innerHTML = `<div class="alert alert-danger">Terjadi kesalahan saat memeriksa update.<br><small>${err.message}</small></div>`;
          console.error('Update check error:', err);
        });
    });  
  </script>
</section>
